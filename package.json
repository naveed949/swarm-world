{
  "name": "@naveed949/swarm-world",
  "version": "0.1.0",
  "private": true,
  "description": "A reproducible implementation of SwarmWorld: persistent, materially grounded societies of LLM agents.",
  "type": "module",
  "bin": {
    "swarm-world": "./dist/cli.js"
  },
  "exports": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage.enabled",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "demo": "npm run build && node dist/cli.js run --config examples/minimal.yaml",
    "docker:build": "docker build --file docker/repository-runner.Dockerfile --tag swarm-world-repository:local .",
    "example:sandcastle:prepare": "sh scripts/prepare-sandcastle-example.sh",
    "example:sandcastle": "sh scripts/run-repository-container.sh .examples/sandcastle examples/repository/sandcastle.yaml runs/sandcastle-container",
    "verify": "npm run check && npm run lint && npm run test && npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.4",
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "commander": "^14.0.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^24.3.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.34.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4"
  }
}
